import NieWeiOrientedSidorenko.KCutPseudo
import NieWeiOrientedSidorenko.KCutSymm

/-!
# The formal compactness hypotheses are the published statements (Checkpoint B, Q3)

Checkpoint B, Q3 (`paper/CHECKPOINT_B_ANSWER_KEY.tex`): "The implementation must also prove the
pseudometric and quotient topology facts needed to identify its formal compactness statement with
the published one." The two formal statements are `FRHSUThm43Hyp` and `FHMZCompactHyp`
(Literature.lean). Each quotients by distance zero, with the topology generated by one-sided
distance balls, and assumes no property of the distance.

This file combines:
* `KCutSymm.cutDistMap_comm` and `KCutSymm.kCutDist_comm`: both map-based cut distances are
  symmetric;
* `KCutPseudo`: nonnegativity, zero self-distance and the triangle inequality, and the topology
  identification (balls generate the pseudometric topology; the quotient by distance zero is the
  metric identification `SeparationQuotient`).

It defines the two pseudometric spaces and proves, with no hypothesis, that each formal hypothesis
is equivalent to the published statement: the metric space obtained by identifying graphons at
cut distance zero is compact. -/

namespace NieWeiOrientedSidorenko

namespace KCompactId

open scoped unitInterval

/-- The map-based cut distance `δ_□^{map}` (`cutDistMap`, FHMZ Definition 12) is symmetric on
digraphons. -/
theorem digraphon_cutDistMap_comm (U W : Digraphon) :
    cutDistMap U.toFun W.toFun = cutDistMap W.toFun U.toFun :=
  KCutSymm.cutDistMap_comm U.isDigraphon W.isDigraphon

/-- The multicolour cut distance `δ_{□_k}` (`kCutDist k`, FRHSU §4.1) is symmetric on
`[k]`-graphons. -/
theorem kGraphon_kCutDist_comm (k : ℕ) (U W : KGraphon k) :
    kCutDist k U.toFun W.toFun = kCutDist k W.toFun U.toFun :=
  KCutSymm.kCutDist_comm U.isKGraphon W.isKGraphon

/-- Digraphons with the map-based cut distance `δ_□^{map}`, as a pseudometric space
(FHMZ's "cut metric"). -/
@[instance_reducible]
noncomputable def cutMapPseudoMetric : PseudoMetricSpace Digraphon :=
  KCutPseudo.digraphonPseudoMetric digraphon_cutDistMap_comm

/-- `[k]`-graphons with the multicolour cut distance `δ_{□_k}`, as a pseudometric space
(FRHSU §4.1). -/
@[instance_reducible]
noncomputable def kCutPseudoMetric (k : ℕ) : PseudoMetricSpace (KGraphon k) :=
  KCutPseudo.kGraphonPseudoMetric k (kGraphon_kCutDist_comm k)

/-- **FHMZ p.6, identified (Q3).** `FHMZCompactHyp` (the quotient of digraphons by
`δ_□^{map} = 0`, with the quotient of the ball topology, is compact) holds if and only if the
metric space obtained from (digraphons, `δ_□^{map}`) by identifying distance zero is compact, as
FHMZ assert: "The space of graphons is compact under the cut metric, given by identifying graphons
with cut distance zero". No hypothesis. -/
theorem fhmzCompactHyp_iff_published :
    FHMZCompactHyp ↔
      letI : PseudoMetricSpace Digraphon := cutMapPseudoMetric
      CompactSpace (SeparationQuotient Digraphon) :=
  KCutPseudo.fhmzCompactHyp_iff_of_symm digraphon_cutDistMap_comm

/-- **FRHSU Theorem 4.3, identified (Q3).** `FRHSUThm43Hyp` holds if and only if, for every
`k ≥ 1`, the metric space `(𝒲̃_k, δ_{□_k})`, obtained from the `[k]`-graphons by identifying
distance zero, is compact: FRHSU's "The space `(𝒲̃_k, δ_{□_k})` is compact". No hypothesis. -/
theorem frhsu_iff_published :
    FRHSUThm43Hyp ↔ ∀ k : ℕ, 1 ≤ k →
      letI : PseudoMetricSpace (KGraphon k) := kCutPseudoMetric k
      CompactSpace (SeparationQuotient (KGraphon k)) :=
  KCutPseudo.frhsu_iff_of_symm kGraphon_kCutDist_comm

end KCompactId

end NieWeiOrientedSidorenko
